## General
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node modules and dependency managers
/node_modules/
/.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build / output
/.next/
/out/
/build/

# Production
/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# OS files
.DS_Store
Thumbs.db

## Environment & secrets (DO NOT commit these)
# .env files - all variants
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Firebase & Google service account files
serviceAccountKey.json
service-account.json
firebase-service-account.json
firebase-adminsdk*.json
google-services.json
google-services-*.json
.gcloud/
firebase.json
.firebaserc
firebase.ts


# Firebase local emulator / runtime data
.firebase/
firebase-debug.log

# Firebase functions dependencies (node modules inside functions should also be ignored if present)
/functions/node_modules/

## Certificates, keys and keystores
*.pem
*.key
*.p12
*.jks
*.pfx
*.crt

## IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

## TypeScript
*.tsbuildinfo
next-env.d.ts

## Coverage and reports
/coverage/
.nyc_output/
coverage/
report/
# Firebase: arquivos sensíveis e configurações locais
# Service account keys / Admin SDK credentials
serviceAccountKey.json
serviceAccount*.json
*-service-account.json
*.service-account.json
firebase-service-account.json
firebase-adminsdk*.json

# Firebase CLI local overrides and env files
.firebaserc.local
.firebaserc.*.local

# Functions local runtime / env / secrets
functions/.runtimeconfig.json
functions/.env
functions/.env.*
functions/.secret

# Emulator state, caches and debug logs
.firebase/
firebase-debug.log
firebase-debug.*
firebase-cache/
emulators/
.emulator-state/

# Local hosting/cache
firebasehosting/
.firebasehosting/

# If you previously committed service account keys or other secrets:
# 1) remove them from the index: `git rm --cached <file>`
# 2) commit the removal and push
# 3) rotate/revoke the compromised keys in Google Cloud Console

## Build caches
.cache/
.parcel-cache/
.turbo/
.next/cache

## Misc
lib-cov/
*.seed
*.pid
pids/

# Lock files (keep at least one lockfile for reproducible installs if your project uses it)
# Uncomment if you want to ignore lockfiles (not recommended)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Ignore local secrets and OS credentials
.credentials/
.aws/
.azure/

# Mac specific
.AppleDouble
.LSOverride

# Prevent committing built static assets (if any)
/public/static/

# Vercel / deployment
.vercel/
.vercel/project.json

# Netlify
/out/*
.netlify/

# Other caches and temp files
*.tmp
*.temp
tmp/
temp/

