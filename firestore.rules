rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {

        /* ================= HELPERS ================= */

        function isAuthenticated() {
            return request.auth != null;
        }

        function userPath() {
            return /databases/$(database)/documents/users/$(request.auth.uid);
        }

        function hasUserDoc() {
            return exists(userPath());
        }

        function userDoc() {
            return get(userPath()).data;
        }

        function isAdmin() {
            return isAuthenticated() && hasUserDoc() && userDoc().role == "admin";
        }

        function isService() {
            return isAuthenticated() && hasUserDoc() && userDoc().role == "service";
        }

        function isField() {
            return isAuthenticated() && hasUserDoc() && userDoc().role == "field";
        }

        function isSelf(userId) {
            return isAuthenticated() && request.auth.uid == userId;
        }

        /* ================= BUILDINGS ================= */

        match /buildings/{buildingId} {

            // 👀 Qualquer usuário autenticado pode ler
            allow read: if isAuthenticated();

            // ✍️ Apenas admin pode criar / editar
            allow create, update, delete: if isAdmin();
        }

        /* ================= USERS ================= */

        match /users/{userId} {

            // 👑 Admin pode tudo (incluindo alterar campo building)
            allow read, write: if isAdmin();

            // 👤 Usuário lê o próprio perfil
            allow read: if isSelf(userId);

            // ✏️ Usuário atualiza apenas dados permitidos (sem building)
            allow update: if
            isSelf(userId)
                && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
            "name",
            "photoURL",
            "firstLogin"
            ]);

            // ❌ Criação e deleção somente via Cloud Function
            allow create, delete: if false;
        }

        /* ================= TICKETS ================= */

        match /tickets/{ticketId} {

            /* 👀 READ */
            allow read: if
            isAuthenticated()
                && hasUserDoc()
                && (
            // 👑 Admin vê tudo
            isAdmin()

                ||

            // 📞 Service vê todos os tickets
            isService()

                ||

            // 🛠 Field vê apenas tickets do seu prédio
            (
            isField()
                && resource.data.buildingId == userDoc().buildingId
            )
            );

            /* ✍️ CREATE */
            allow create: if isService()
                && request.resource.data.keys().hasOnly([
            "code",
            "requester",
            "description",
            "buildingId",
            "sector",
            "room",
            "status",
            "assignedTo",
            "createdAt",
            "solvedAt"
            ])
                && request.resource.data.status == "aberto";


            /* 🔄 UPDATE */
            allow update: if
            isAuthenticated()
                && hasUserDoc()
                && (

            // 👑 Admin pode tudo
            isAdmin()

                ||

            // 🛠 Field assume ou finaliza chamado
            (
            isField()
                && resource.data.buildingId == userDoc().buildingId
                && (
            // assumir chamado
            (
            resource.data.status == "aberto"
                && request.resource.data.status == "em_atendimento"
                && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
            "status",
            "assignedTo",
            "startedAt"
            ])
            )

                ||

            // finalizar chamado
            (
            resource.data.assignedTo.uid == request.auth.uid
                && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
            "status",
            "solvedAt"
            ])
            )
            )
            )

                ||

            // 📞 Service altera status enquanto não finalizado
            (
            isService()
                && resource.data.status != "atendido"
                && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status"])
            )
            );

            /* ❌ DELETE */
            allow delete: if false;
        }
    }
}
