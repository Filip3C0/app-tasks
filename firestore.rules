rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == "admin";
    }

    function isService() {
      return userRole() == "service";
    }

    function isField() {
      return userRole() == "field";
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (isAdmin() || isService());

      allow update: if isAdmin() || isService() || (
        isField() && (
          (request.resource.data.assignedTo.uid == request.auth.uid) ||
          (resource.data.assignedTo.uid == request.auth.uid)
        )
      );
    }

    match /buildings/{buildingId} {
      allow read: if isSignedIn();
    }

    match /notifications/{notifId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
